# Copia in .env.local (sviluppo) o nelle variabili d'ambiente di Vercel (produzione).
# Nessuna di queste variabili, tranne le NEXT_PUBLIC_*, arriva al browser.

# URL pubblico dell'app (senza / finale)
APP_URL=https://leads.weborastudio.it

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Motore n8n
N8N_ENGINE_WEBHOOK_URL=https://lefonti.app.n8n.cloud/webhook/lead-engine/v1/search
# Header e valore della credenziale n8n "Lead Engine - Webhook in ingresso" (Header Auth)
N8N_ENGINE_HEADER_NAME=X-Engine-Key
N8N_ENGINE_HEADER_VALUE=
# Valore dell'header X-Engine-Secret della credenziale "Lead Engine - Callback verso backend"
ENGINE_CALLBACK_SECRET=
# Facoltativo: link alle esecuzioni nel pannello admin
N8N_BASE_URL=https://lefonti.app.n8n.cloud

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Cron (Vercel invia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Email transazionali (facoltativo): https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Webora Leads <leads@weborastudio.it>"

# Facoltativo: verifica che le caselle email esistano (MillionVerifier, ~0,002 € a email).
# Senza chiave si controlla solo che il dominio riceva posta (record MX).
MILLIONVERIFIER_API_KEY=
